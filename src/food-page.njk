---
layout: base.njk
pagination:
  data: "foodpages.items"
  size: 1
  alias: food
permalink: "/food/{{ food.slug }}/index.html"
eleventyComputed:
  title: "{{ food.pageName }} Nutrition in Pregnancy"
  description: "{{ food.metaDescription }}"
  schemaType: WebPage
  bodyClass: page-food-detail
vizStyles: true
pageStyles:
  - /style/food-page.css?v=20261027-small
---
{% set verdict = food.guidance.verdict if food.guidance else ("Avoid" if food.isAvoid else "") %}
<article class="section fp">
  <nav class="fp-crumbs" aria-label="Breadcrumb">
    <a href="/">Home</a><span aria-hidden="true">/</span><a href="/food/">Foods</a>
  </nav>

  <header class="fp-hero{% if food.image and food.image.src %} has-image{% endif %}">
    {% if food.image and food.image.src %}
      <img class="fp-cutout" src="{{ food.image.src }}" alt="" width="{{ food.image.width }}" height="{{ food.image.height }}" loading="eager" fetchpriority="high">
    {% endif %}
    <div class="fp-hero-text">
      {% if verdict %}<p class="fp-verdict is-{{ verdict | lower | replace(' ', '-') }}">{{ verdict }}</p>{% endif %}
      <h1 class="fp-name{% if food.heading | length > 22 %} is-long{% endif %}">{{ food.heading }}</h1>
      {% if food.answer %}<p class="fp-answer">{{ food.answer }}</p>{% endif %}
      {% if food.isHumanMilk %}
        <p class="fp-answer">A historical data record, not a pregnancy food recommendation.</p>
      {% elif food.isRawPulse or food.isRawFlour %}
        <p class="fp-aside">Uncooked ingredient: values are before cooking.</p>
      {% endif %}
    </div>
  </header>

  <section class="fp-card" aria-labelledby="fp-nutrients-title">
    <div class="fp-card-head">
      <h2 class="fp-card-title" id="fp-nutrients-title">Pregnancy nutrients</h2>
      <div class="fp-toggle" role="radiogroup" aria-label="Amount">
        <label><input type="radio" name="fp-amount" id="fp-serving" value="serving" checked><span>{{ food.serving.label }}</span></label>
        <label><input type="radio" name="fp-amount" id="fp-100g" value="100g"><span>100 g</span></label>
      </div>
    </div>
    <ol class="fp-rows">
      {% set trace = [] %}
      {% for row in food.chartRows %}
        {% set s = food.serving.rows[loop.index0] %}
        {% if row.displayPercent == 0 or row.displayPercent == null %}{% set trace = (trace.push(row.name), trace) %}{% else %}
        <li class="fp-row" style="--c: {{ row.color }}; --s: {{ s.barPercent }}%; --h: {{ row.barPercent }}%;">
          <span class="fp-row-name">{{ row.label }}</span>
          <span class="fp-row-amount"><span class="is-serving">{{ s.amount }} {{ row.unit }}</span><span class="is-100g">{{ row.amount }} {{ row.unit }}</span></span>
          <span class="fp-row-pct"><span class="is-serving">{{ s.displayPercent }}<small>%</small></span><span class="is-100g">{{ row.displayPercent }}<small>%</small></span></span>
          <span class="fp-row-bar" aria-hidden="true"><span></span></span>
        </li>
        {% endif %}
      {% endfor %}
    </ol>
    <p class="fp-note">Share of the daily amount needed in pregnancy{% if trace.length %}. Under 1% per 100 g: {{ trace | join(", ") | replace("Vitamin B-", "Vitamin B") }}{% endif %}.</p>
    <details class="viz-more fp-table">
      <summary>Full nutrient table per 100 g</summary>
      <div class="table-shell">
        <table class="data-table">
          <caption class="sr-only">Nutrients per 100 grams</caption>
          <thead><tr><th scope="col">Nutrient</th><th scope="col" class="is-num">In 100 g</th><th scope="col" class="is-num">Daily reference</th></tr></thead>
          <tbody>
            {% for row in food.nutrientRows %}
              <tr><th scope="row">{{ row.name }}</th><td class="is-num">{{ row.value | formatNumber }} {{ row.unit }}</td><td class="is-num">{{ row.target }}</td></tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </details>
  </section>

  {% if food.guidance %}
    <section class="fp-why" id="food-guidance" aria-labelledby="fp-why-title">
      <h2 class="fp-section-title" id="fp-why-title">In pregnancy</h2>
      {% if food.guidance.claims %}
        {% for claim in food.guidance.claims %}<p>{{ claim.text }} <a href="{{ claim.source.url | escape }}">{{ claim.source.name }}</a></p>{% endfor %}
      {% else %}
        <p>{{ food.guidance.explanation }}</p>
        {% if food.guidance.sources and food.guidance.sources.length %}
          <p class="fp-sources">Sources: {% for src in food.guidance.sources %}<a href="{{ src.url }}" target="_blank" rel="noopener noreferrer">{{ src.name }}</a>{% if not loop.last %} · {% endif %}{% endfor %}</p>
        {% endif %}
      {% endif %}
      {% if food.guidance.dateModified %}<p class="fp-sources">Updated {{ food.guidance.dateModified | readableDate }}</p>{% endif %}
    </section>
  {% elif food.warning or food.isRawPulse or food.isRawFlour %}
    <section class="fp-why" id="food-safety" aria-labelledby="fp-why-title">
      <h2 class="fp-section-title" id="fp-why-title">In pregnancy</h2>
      {% if food.isRawPulse %}
        <p>Cook dried pulses fully before eating; cooking also changes weight and nutrients per 100 g. <a href="https://www.efsa.europa.eu/en/news/lectins-food-undercooked-beans-pose-health-risk-says-efsa">EFSA on undercooked beans</a>{% if food.id == "16069" %} · <a href="/food/16070-lentils-mature-seeds-boiled/">Boiled lentils</a>{% endif %}</p>
      {% elif food.isRawFlour %}
        <p>Don't eat raw dough or batter; cook flour foods as directed. <a href="https://www.cdc.gov/food-safety/foods/no-raw-dough.html">CDC on raw flour</a></p>
      {% else %}
        <p>{{ food.warningText }}
          {% if food.id == "05028" or food.id == "13327" %}<a href="https://www.nhs.uk/pregnancy/keeping-well/foods-to-avoid/">NHS source</a>
          {% elif food.group == "Finfish and Shellfish Products" %}<a href="https://www.fda.gov/food/consumers/advice-about-eating-fish">FDA/EPA fish chart</a>
          {% else %}<a href="https://www.cdc.gov/food-safety/foods/pregnant-women.html">CDC source</a>{% endif %}
        </p>
      {% endif %}
    </section>
  {% endif %}

  {% if not food.isHumanMilk %}
    {% if food.relatedFoods.length %}
      <section class="fp-similar" aria-labelledby="fp-similar-title">
        <h2 class="fp-section-title" id="fp-similar-title">Similar foods</h2>
        <ul class="fp-similar-list">
          {% for related in food.relatedFoods %}
            <li><a href="{{ related.url }}">
              {% if related.image %}<img src="{{ related.image }}" alt="" width="96" height="96" loading="lazy" decoding="async">{% else %}<span class="fp-similar-letter" aria-hidden="true">{{ related.name | first | upper }}</span>{% endif %}
              <span>{{ related.name }}</span>
            </a></li>
          {% endfor %}
        </ul>
      </section>
    {% endif %}

    <nav class="fp-more" aria-label="Keep reading">
      <ul class="viz-pill-links">
        {% for link in food.toolLinks %}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{% endfor %}
        {% for link in food.readingLinks %}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{% endfor %}
      </ul>
    </nav>
  {% endif %}

  <footer class="fp-foot">
    <p>USDA record: {{ food.pageName }} · {{ food.group }}. A serving follows FDA reference amounts ({{ food.serving.grams }} g). Values come from a historical USDA-based dataset; DHA and protein use illustrative benchmarks. See <a href="https://www.cdc.gov/food-safety/foods/pregnant-women.html">CDC pregnancy food safety</a> and <a href="/about/#food-data-sources">sources and limits</a>. Not medical advice.</p>
  </footer>
</article>
