<!doctype html>
<html lang="en">
  <head>
    {% if food %}
      {% set pageTitle = food.pageName + " Nutrition in Pregnancy" %}
      {% set pageDescription = food.metaDescription %}
    {% elif period %}
      {% set pageTitle = "Pregnancy Nutrition Weeks " + period.weeks.start + "–" + period.weeks.end %}
      {% set pageDescription = period.summary %}
    {% else %}
      {% set pageTitle = title or site.name %}
      {% set pageDescription = description or site.description %}
    {% endif %}
    {% set socialTitle = food.seoTitle if food else (pageTitle if pageTitle == site.name else pageTitle + " | " + site.name) %}
    {% set pageUrl = site.url + page.url %}
    {% set pageSchemaType = schemaType or "WebPage" %}
    {% set pageModifiedDate = dateModified or page.date %}
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="{{ pageDescription | escape }}">
    <meta name="author" content="{{ (author or site.author) | escape }}">
    <meta name="theme-color" content="#f3f0e8">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    {% if noindex or (food and food.topNutrients.length == 0) %}<meta name="robots" content="noindex">{% endif %}
    <meta property="og:type" content="{{ ogType or 'website' }}">
    <meta property="og:site_name" content="{{ site.name }}">
    <meta property="og:title" content="{{ socialTitle | escape }}">
    <meta property="og:description" content="{{ pageDescription | escape }}">
    <meta property="og:locale" content="en_US">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ socialTitle | escape }}">
    <meta name="twitter:description" content="{{ pageDescription | escape }}">
    <script src="/js/cookie-consent.js" defer></script>
    {% if site.url %}
      <link rel="canonical" href="{{ pageUrl }}">
      <meta property="og:url" content="{{ pageUrl }}">
      <meta property="og:image" content="{{ site.url }}{{ socialImage or site.socialImage }}">
      <meta property="og:image:type" content="image/jpeg">
      <meta property="og:image:width" content="1200">
      <meta property="og:image:height" content="630">
      <meta property="og:image:alt" content="Illustration of a pregnant person holding an acorn">
      <meta name="twitter:image" content="{{ site.url }}{{ socialImage or site.socialImage }}">
      <meta name="twitter:image:alt" content="Illustration of a pregnant person holding an acorn">
      {% if pageSchemaType == "Article" %}
        {% if author == site.author %}
          {% set articleAuthor = {"@type": "Person", "name": author, "url": site.url + "/about/#editorial"} %}
        {% else %}
          {% set articleAuthor = {"@type": "Person", "name": author or site.author} %}
        {% endif %}
        <script type="application/ld+json">{{ {
          "@context": "https://schema.org",
          "@type": "Article",
          "headline": pageTitle,
          "description": pageDescription,
          "url": pageUrl,
          "image": site.url + (socialImage or site.socialImage),
          "datePublished": page.date | isoDate,
          "dateModified": pageModifiedDate | isoDate,
          "author": articleAuthor,
          "mainEntityOfPage": {"@type": "WebPage", "@id": pageUrl},
          "isPartOf": {"@type": "WebSite", "name": site.name, "url": site.url}
        } | jsonLd | safe }}</script>
      {% else %}
        <script type="application/ld+json">{{ {
          "@context": "https://schema.org",
          "@type": pageSchemaType,
          "name": pageTitle,
          "description": pageDescription,
          "url": pageUrl,
          "isPartOf": {"@type": "WebSite", "name": site.name, "url": site.url}
        } | jsonLd | safe }}</script>
      {% endif %}
      {% if food %}
        <script type="application/ld+json">{{ {
          "@context": "https://schema.org",
          "@type": "BreadcrumbList",
          "itemListElement": [
            {"@type": "ListItem", "position": 1, "name": "Home", "item": site.url + "/"},
            {"@type": "ListItem", "position": 2, "name": "Foods", "item": site.url + "/food/"},
            {"@type": "ListItem", "position": 3, "name": food.pageName, "item": pageUrl}
          ]
        } | jsonLd | safe }}</script>
      {% elif period %}
        <script type="application/ld+json">{{ {
          "@context": "https://schema.org",
          "@type": "BreadcrumbList",
          "itemListElement": [
            {"@type": "ListItem", "position": 1, "name": "Home", "item": site.url + "/"},
            {"@type": "ListItem", "position": 2, "name": "Weekly Guide", "item": site.url + "/weekly-diet/"},
            {"@type": "ListItem", "position": 3, "name": pageTitle, "item": pageUrl}
          ]
        } | jsonLd | safe }}</script>
      {% elif pageSchemaType == "Article" %}
        <script type="application/ld+json">{{ {
          "@context": "https://schema.org",
          "@type": "BreadcrumbList",
          "itemListElement": [
            {"@type": "ListItem", "position": 1, "name": "Home", "item": site.url + "/"},
            {"@type": "ListItem", "position": 2, "name": "Pregnancy nutrition guides", "item": site.url + "/blog/"},
            {"@type": "ListItem", "position": 3, "name": pageTitle, "item": pageUrl}
          ]
        } | jsonLd | safe }}</script>
      {% endif %}
    {% endif %}
    {% if pageSchemaType == "Article" and page.date %}<meta property="article:published_time" content="{{ page.date | isoDate }}">{% endif %}
    {% if pageSchemaType == "Article" and dateModified %}<meta property="article:modified_time" content="{{ dateModified | isoDate }}">{% endif %}
    {% set documentTitle = seoTitle or pageTitle %}
    <title>{% if food %}{{ food.seoTitle | escape }}{% elif documentTitle == site.name %}{{ documentTitle | escape }}{% else %}{{ documentTitle | escape }} | {{ site.name }}{% endif %}</title>
    <link rel="stylesheet" href="/style/easy-autocomplete.css">
    <link rel="stylesheet" href="/style/style.css">
    {% if pageStyles %}
      {% for href in pageStyles %}
        <link rel="stylesheet" href="{{ href }}">
      {% endfor %}
    {% endif %}
    <link rel="stylesheet" href="/style/overhaul.css">
  </head>
  <body{% if bodyClass %} class="{{ bodyClass }}"{% endif %}>
    {% include "components/navbar.njk" %}
    <main class="page">
      {{ content | safe }}
    </main>
    {% include "components/footer.njk" %}
    <div class="cookie-banner" id="CookieBanner" role="region" aria-label="Analytics cookie choice" hidden>
      <p>We use optional Google Analytics cookies to understand site visits. Choose whether to allow them. <a href="/privacy/">Privacy details</a></p>
      <div class="cookie-actions">
        <button type="button" id="CookieReject">Reject optional cookies</button>
        <button type="button" id="CookieAccept">Accept analytics</button>
      </div>
    </div>
    <script src="/js/jquery.min.js"></script>
    <script src="/js/jquery.easy-autocomplete.min.js"></script>
    <script src="/js/searchbar.js"></script>
    <script src="/js/caution.js"></script>
    {% if pageScripts %}
      {% for src in pageScripts %}
        <script src="{{ src }}"></script>
      {% endfor %}
    {% endif %}
  </body>
</html>
