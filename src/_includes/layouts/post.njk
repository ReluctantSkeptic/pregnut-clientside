---
layout: base.njk
---

<article class="post">
  <nav class="post-breadcrumbs" aria-label="Breadcrumb">
    <a href="/">Home</a><span aria-hidden="true">/</span><a href="/blog/">Pregnancy nutrition guides</a><span aria-hidden="true">/</span><span aria-current="page">{{ title }}</span>
  </nav>
  <header class="post-header">
    <p class="post-meta"><time datetime="{{ page.date | isoDate }}">Published {{ page.date | readableDate }}</time>{% if dateModified %} · <time datetime="{{ dateModified | isoDate }}">Updated {{ dateModified | readableDate }}</time>{% endif %}{% if author %} · By {% if author == site.author %}<a href="/about/#editorial">{{ author }}</a>{% else %}{{ author }}{% endif %}{% endif %}</p>
    <h1 class="post-title">{{ title }}</h1>
    {% if description %}<p class="post-dek">{{ description }}</p>{% endif %}
  </header>
  <div class="prose">
    {{ content | safe }}
  </div>
</article>
