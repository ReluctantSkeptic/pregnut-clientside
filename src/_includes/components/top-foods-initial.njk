{% for food in topFoods.initial.whole %}
<li class="tf-row" style="--p: {% if food.percent > 100 %}100{% else %}{{ food.percent }}{% endif %}%">
  <span class="tf-rank" aria-hidden="true">{{ loop.index }}</span>
  {% if food.image %}<img class="tf-pic" src="{{ food.image }}" alt="" width="200" height="200"{% if loop.index > 3 %} loading="lazy"{% endif %} decoding="async">{% else %}<span class="tf-pic is-letter" aria-hidden="true">{{ food.label | first | upper }}</span>{% endif %}
  <span class="tf-copy">
    <a class="tf-name" href="{{ food.url }}">{{ food.label }}</a>
    <span class="tf-serving">{{ food.serving }} · {{ food.amount }}</span>
  </span>
  {% if food.warning %}<span class="caution is-safety"><button class="caution-trigger" type="button" aria-label="Safety note: {{ food.warning | escape }}: {{ (food.warningText or 'Use caution.') | escape }}" aria-expanded="false">!</button><span class="caution-popover" role="tooltip">{{ food.warning }}: {{ food.warningText or 'Use caution.' }}</span></span>{% endif %}
  <span class="tf-pct">{{ food.percent }}<small>%</small></span>
  <span class="tf-bar" aria-hidden="true"><i></i></span>
</li>
{% endfor %}
