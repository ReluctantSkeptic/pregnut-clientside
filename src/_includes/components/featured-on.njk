{# Edit the badge list in src/_data/featuredBadges.json (most reputable first).
   Two rows scroll in opposite directions. The second group in each row is a
   decorative copy: aria-hidden, not in the tab order. #}
<section class="featured-on" aria-labelledby="FeaturedOnTitle">
  <h2 class="featured-on__title" id="FeaturedOnTitle">Featured on</h2>
  {% for row in [0, 1] %}
  <div class="featured-on__viewport">
    <div class="featured-on__track{% if row %} featured-on__track--rev{% endif %}">
      {% for copy in [0, 1] %}
      <div class="featured-on__group"{% if copy %} aria-hidden="true"{% endif %}>
        {%- for b in featuredBadges -%}
        {%- if (row == 0 and loop.index <= (featuredBadges.length / 2)) or (row == 1 and loop.index > (featuredBadges.length / 2)) %}
        <a class="featured-on__link{% if b.knockout %} featured-on__link--knockout{% endif %}" href="{{ b.href }}" target="_blank" rel="noopener"{% if copy %} tabindex="-1"{% endif %}{% for k, v in b.data %} {{ k }}="{{ v }}"{% endfor %}>
          <img src="{{ b.src }}" alt="{% if not copy %}{{ b.alt }}{% endif %}" width="{{ b.width }}" height="{{ b.height }}" loading="{% if copy %}lazy{% else %}{{ b.loading or "lazy" }}{% endif %}" decoding="async" />
        </a>
        {% endif -%}
        {%- endfor %}
      </div>
      {% endfor %}
    </div>
  </div>
  {% endfor %}
</section>
<script>(function(){var s=document.currentScript.previousElementSibling;if(!s)return;if(!("IntersectionObserver" in window)){s.classList.add("is-in");return;}var o=new IntersectionObserver(function(e){if(e[0].isIntersecting){s.classList.add("is-in");o.disconnect();}},{threshold:0.2});o.observe(s);})();</script>
