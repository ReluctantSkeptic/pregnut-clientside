{# Edit badge list in src/_data/featuredBadges.json #}
<section class="featured-on" aria-label="Featured on">
  <p class="featured-on__label">Featured on</p>
  <div class="featured-on__viewport">
    <div class="featured-on__track">
      <div class="featured-on__group">
        {% for b in featuredBadges %}
        <a class="featured-on__link" href="{{ b.href }}" target="_blank" rel="noopener noreferrer">
          <img src="{{ b.src }}" alt="{{ b.alt }}" width="{{ b.width }}" height="{{ b.height }}" loading="lazy" decoding="async" />
        </a>
        {% endfor %}
      </div>
      <div class="featured-on__group" aria-hidden="true">
        {% for b in featuredBadges %}
        <a class="featured-on__link" href="{{ b.href }}" target="_blank" rel="noopener noreferrer" tabindex="-1">
          <img src="{{ b.src }}" alt="" width="{{ b.width }}" height="{{ b.height }}" loading="lazy" decoding="async" />
        </a>
        {% endfor %}
      </div>
    </div>
  </div>
</section>
