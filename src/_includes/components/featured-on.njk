{# Edit badge list in src/_data/featuredBadges.json #}
<section class="featured-on" aria-labelledby="FeaturedOnTitle">
  <h2 class="featured-on__title" id="FeaturedOnTitle">Featured on</h2>
  <ul class="featured-on__list">
    {% for b in featuredBadges %}
    <li>
      <a class="featured-on__link" href="{{ b.href }}" target="_blank" rel="noopener noreferrer"{% for k, v in b.data %} {{ k }}="{{ v }}"{% endfor %}>
        <img src="{{ b.src }}" alt="{{ b.alt }}" width="{{ b.width }}" height="{{ b.height }}" loading="lazy" decoding="async" />
      </a>
    </li>
    {% endfor %}
  </ul>
</section>
