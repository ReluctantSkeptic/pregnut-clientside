{# Edit badge list in src/_data/featuredBadges.json (most reputable first).
   The list is split into two rows. Each row's second group is a decorative aria-hidden copy so the marquee can loop; both marquees start once the band is in view. #}
<section class="featured-on" aria-labelledby="FeaturedOnTitle">
  <h2 class="featured-on__title" id="FeaturedOnTitle">Featured on</h2>
  {% set topCount = (featuredBadges | length / 2) | round(0, "ceil") %}
  {% set topBadges = featuredBadges.slice(0, topCount) %}
  {% set bottomBadges = featuredBadges.slice(topCount) %}
  {% for row in [
    { dir: "left", badges: topBadges },
    { dir: "right", badges: bottomBadges }
  ] %}
  <div class="featured-on__viewport">
    <div class="featured-on__track featured-on__track--{{ row.dir }}">
      {% for copy in [0, 1] %}
      <div class="featured-on__group"{% if copy %} aria-hidden="true"{% endif %}>
        {% for b in row.badges %}
        <a class="featured-on__link" href="{{ b.href }}" target="_blank" rel="noopener noreferrer"{% if copy %} tabindex="-1"{% endif %}{% for k, v in b.data %} {{ k }}="{{ v }}"{% endfor %}>
          <img src="{{ b.src }}" alt="{% if not copy %}{{ b.alt }}{% endif %}" width="{{ b.width }}" height="{{ b.height }}" loading="lazy" decoding="async" />
        </a>
        {% endfor %}
      </div>
      {% endfor %}
    </div>
  </div>
  {% endfor %}
</section>
<script>(function(){var s=document.currentScript.previousElementSibling;if(!s)return;if(!("IntersectionObserver" in window)){s.classList.add("is-in");return;}var o=new IntersectionObserver(function(e){if(e[0].isIntersecting){s.classList.add("is-in");o.disconnect();}},{threshold:0.2});o.observe(s);})();</script>
