        <li><a href="https://ods.od.nih.gov/factsheets/Choline-HealthProfessional/">NIH: Choline food table</a></li>
        <li><a href="https://ods.od.nih.gov/factsheets/Folate-HealthProfessional/">NIH: Folate and folic acid</a></li>
        <li><a href="https://www.cdc.gov/food-safety/foods/pregnant-women.html">CDC: Safer food choices for pregnant women</a></li>
      {% elif period.id == "wk13-16" %}
        <li><a href="https://ods.od.nih.gov/factsheets/Choline-HealthProfessional/">NIH: Choline food table</a></li>
        <li><a href="https://ods.od.nih.gov/factsheets/Calcium-HealthProfessional/">NIH: Calcium food table</a></li>
        <li><a href="https://www.fda.gov/food/consumers/advice-about-eating-fish">FDA/EPA: Advice about eating fish</a></li>
        <li><a href="https://www.cdc.gov/food-safety/foods/pregnant-women.html">CDC: Safer food choices for pregnant women</a></li>
      {% elif period.id == "wk21-24" %}
        <li><a href="https://ods.od.nih.gov/factsheets/Iron-HealthProfessional/">NIH: Iron food table and absorption</a></li>
        <li><a href="https://ods.od.nih.gov/factsheets/VitaminC-HealthProfessional/">NIH: Vitamin C food table</a></li>
        <li><a href="https://www.fda.gov/food/consumers/advice-about-eating-fish">FDA/EPA: Advice about eating fish</a></li>
        <li><a href="https://www.cdc.gov/food-safety/foods/pregnant-women.html">CDC: Safer food choices for pregnant women</a></li>
      {% endif %}
    </ul>
  </section>

